{
  "name": "@zentrixlabs/mediloop",
  "version": "1.0.0",
  "description": "A small TypeScript client for the Mediloop API: tokens, safe retries, paging, webhook checks and Sign in with Mediloop.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/run.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/zentrix-innovative-labs/mediloop-typescript.git" },
  "bugs": { "url": "https://github.com/zentrix-innovative-labs/mediloop-typescript/issues" },
  "homepage": "https://docs.mediloop.co",
  "keywords": ["mediloop", "health", "uganda", "fhir", "api"]
}
